<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <keyboard>
    <keybind key="A-F4"><action name="Execute"><command>/bin/true</command></action></keybind>
    <keybind key="W-q"><action name="Execute"><command>/bin/true</command></action></keybind>
    <keybind key="A-Tab"><action name="Execute"><command>/bin/true</command></action></keybind>
    <keybind key="A-Escape"><action name="Execute"><command>/bin/true</command></action></keybind>
  </keyboard>
  <mouse>
    <context name="Desktop"><mousebind button="Right"><action name="Execute"><command>/bin/true</command></action></mousebind></context>
  </mouse>
</openbox_config>
